diff --git a/cpu.cpp b/cpu.cpp
index 44b57c4..1de2c40 100644
--- a/cpu.cpp
+++ b/cpu.cpp
@@ -18,6 +18,7 @@
 // https://github.com/weidai11/cryptopp/issues/972
 #if (CRYPTOPP_MSC_VERSION >= 1600) && (defined(_M_IX86) || defined(_M_X64))
 # include <immintrin.h>
+# include <intrin.h>
 #endif
 
 // For IsProcessorFeaturePresent on Microsoft Arm64 platforms,
@@ -81,7 +82,23 @@ unsigned long int getauxval(unsigned long int) { return 0; }
 // Required by Visual Studio 2008 and below and Clang on Windows.
 // Use it for all MSVC-compatible compilers.
 // XGETBV64 and CPUID64 are in x64dll.asm.
-#if defined(_M_X64) && defined(CRYPTOPP_MS_STYLE_INLINE_ASSEMBLY)
+#if defined(_M_X64) && defined(CRYPTOPP_MS_STYLE_INLINE_ASSEMBLY) && !defined(CRYPTOPP_X64_MASM_AVAILABLE)
+extern "C" unsigned long long __fastcall XGETBV64(unsigned int num)
+{
+	return _xgetbv(num);
+}
+
+extern "C" unsigned long long __fastcall CPUID64(unsigned int func, unsigned int subfunc, unsigned int* output)
+{
+	int regs[4];
+	__cpuidex(regs, static_cast<int>(func), static_cast<int>(subfunc));
+	output[0] = static_cast<unsigned int>(regs[0]);
+	output[1] = static_cast<unsigned int>(regs[1]);
+	output[2] = static_cast<unsigned int>(regs[2]);
+	output[3] = static_cast<unsigned int>(regs[3]);
+	return 1;
+}
+#elif defined(_M_X64) && defined(CRYPTOPP_MS_STYLE_INLINE_ASSEMBLY)
 extern "C" unsigned long long __fastcall XGETBV64(unsigned int);
 extern "C" unsigned long long __fastcall CPUID64(unsigned int, unsigned int, unsigned int*);
 #endif
